#!/usr/bin/env python3
"""Generate ARAX pytest modules from JSON."""
import json
import re
import sys
from pathlib import Path
from textwrap import dedent


def generate_test_files(arax_dir: Path, tests: list[dict]):
    """Generate one file each for tests with multiple assertions."""
    for test in tests:
        safe_name = test["candidate_name"].replace(" ", "_").lower()

        s = dedent(f"""
        # DO NOT MODIFY: This file was generated by scripts/generate_arax_tests
        from dataclasses import replace
        
        import pytest
        from translator_tom import Response

        import xcrg
        from tests.utilities import (
            XCRG_Answer,
            assert_answer,
            {test["type"]},
        )
        
        TEST_NAME = "arax_test_{test["direction"]}_{safe_name}"
        
        """).lstrip()

        for comment in test.get("comments", []):
            s += f"# {comment}\n"

        s += dedent(f"""
        @pytest.fixture(scope = "module")
        def response(config: xcrg.XCRGConfig) -> Response:
            config = replace(config, debug_run_name = TEST_NAME)
            return {test["type"]}(config, "{test["direction"]}", "{test["candidate_id"]}") # {test["candidate_name"]}

        @pytest.mark.xdist_group(name = TEST_NAME)
        @pytest.mark.parametrize(
            "answer",
            [
        """).lstrip()

        answers = []
        for answer in test["answers"]:
            x = ""
            for comment in answer.get("comments", []):
                x += f"        # {comment}\n"
            x += f'        XCRG_Answer("{answer["id"]}", "{answer["expectation"]}"'
            if answer.get("fails_on_arax", False):
                x += ", fails_on_arax = True"
            x += f"), # {answer["name"]}"
            answers.append(x)
        s += "\n".join(answers)

        s += dedent(f"""
            ]
        )
        def test_{test["direction"].lower()}_activity_or_abundance_of_{safe_name}(response: Response, answer: XCRG_Answer):
            assert_answer(response, answer)
        """)

        test_file = arax_dir / f"test_{test["direction"]}_{safe_name}.py"
        with open(test_file, "w") as f:
            f.write(s)


def generate_one_shot_tests(arax_dir: Path, tests: list[dict]):
    """Generate one file that includes all tests with a single assertion."""
    s = dedent(f"""
    # DO NOT MODIFY: This file was generated by scripts/generate_arax_tests
    from dataclasses import replace
    
    import xcrg
    from tests.utilities import (
        XCRG_Answer,
        assert_answer,
        find_chemicals_affecting_gene,
        find_genes_affected_by_chemical,
    )
    
    
    """).lstrip()

    for test in tests:
        safe_candidate_name = test["candidate_name"].replace(" ", "_").lower()

        answer = test["answers"][0]
        safe_answer_name = re.sub("[ -]", "_", answer["name"].lower())
        safe_answer_name = re.sub("[^a-z0-9_]", "", safe_answer_name)

        for comment in test.get("comments", []):
            s += f"# {comment}\n"

        fails = ""
        if answer.get("fails_on_arax", False):
            fails = ", fails_on_arax = True"

        s += dedent(f"""
        def test_{safe_answer_name}_{test["direction"]}_activity_or_abundance_of_{safe_candidate_name}(config: xcrg.XCRGConfig):
            config = replace(config, debug_run_name = "arax_test_{test["direction"]}_{safe_candidate_name}")
            response = {test["type"]}(config, "{test["direction"]}", "{test["candidate_id"]}")  # {test["candidate_name"]}
            assert_answer(response, XCRG_Answer("{answer["id"]}", "{answer["expectation"]}"{fails}))  # {answer["name"]}
        
        """).lstrip()

    # Hack: fix end of file to have a single newline
    s = s.rstrip() + "\n"

    test_file = arax_dir / f"test_oneshots.py"
    with open(test_file, "w") as f:
        f.write(s)


def main():
    script_file = Path(sys.argv[0])
    project_dir = script_file.parent.parent # TODO: fragile

    json_file = script_file.parent / "arax_tests.json"
    with open(json_file, "r") as f:
        arax_tests = json.load(f)

    arax_dir = project_dir / "tests" / "arax"

    multiple_answers = [x for x in arax_tests if len(x["answers"]) > 1]
    generate_test_files(arax_dir, multiple_answers)

    single_answers = [x for x in arax_tests if len(x["answers"]) == 1]
    generate_one_shot_tests(arax_dir, single_answers)


if __name__ == "__main__":
    main()
