#!/usr/bin/env bash
# Run linter + type checks on the codebase

SCRIPT_FILE="$0"
SCRIPTS_DIR="$(dirname "$SCRIPT_FILE")"
PROJECT_DIR="$SCRIPTS_DIR/.."

print_help_and_exit() {
	cat <<-EOF
	Run linter + type checks on the codebase.

	usage: $SCRIPT_FILE <options>

	Options:
	    -h, --help    Print this message and exit.
	EOF
	exit 0
}

while (($# > 0)); do
	opt="$1" && shift
	case "$opt" in
		-h|--help)
			print_help_and_exit
			;;
		*)
			printf "Unknown option: %s\n" "$opt" && exit 1
			;;
	esac
done

# The paths that will be passed to checkers
declare -a PATHS

# Include the standard directories
PATHS+=("$PROJECT_DIR/src")
PATHS+=("$PROJECT_DIR/tests")

# Additionally, include scripts with python shebang
while read -r SCRIPT_FILE; do
    if head -n1 "$SCRIPT_FILE" | grep -q "python"; then
        PATHS+=("$SCRIPT_FILE")
    fi
done < <(find "$SCRIPTS_DIR" -type f)

# printf "%s\n" "${PATHS[@]}"

ruff_ignores=(
    BLE001 # blind-except
    E701   # multiple-statements-on-one-line-colon
    I001   # unsorted-imports
    RUF018 # assignment-in-assert (We do this a lot to help the type-checker)
    TRY002 # raise-vanilla-class
)

ruff check "${PATHS[@]}" --ignore "$(IFS=,; echo "${ruff_ignores[*]}")"
ty check "${PATHS[@]}"
